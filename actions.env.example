# Keys for alerts and actions. Copy this file to actions.env, which Git ignores, and fill in what you use.
# The server writes WEBPUSH_PRIVATE_KEY and NTFY_TOPIC itself the first time you pair a browser or the ntfy app.
TELEGRAM_BOT_TOKEN=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=
WHENEVER_MAIL_FROM=Whenever <alerts@example.com>
