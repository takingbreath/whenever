# One camera on each line: an address, a name, then what it can do. Copy this file to camera.env, which Git ignores.
# These addresses are examples. See "Use security cameras" in the README for every make.
ezviz:K12345678 Driveway
ezviz-rtp:BD1234567:1 Gate wide
ezviz-rtp:BD1234567:2 Gate tracker | moving light
rtsp://user:code@192.168.1.20:554/Streaming/Channels/101 Shop
# To send these cameras to a hosted Whenever:
# WHENEVER_SERVER=https://your.whenever.host
# WHENEVER_CODE=the access code
