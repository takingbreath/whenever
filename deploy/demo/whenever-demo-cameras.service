# The demo's cameras: camera.py plays each recorded clip in /srv/whenever/demo/footage in a loop, as a
# camera would send it, through the demo's own media server. camera.env in /srv/whenever/demo/app lists
# the clips (deploy/demo/camera.env.demo). It uses the demo server's own access code.

[Unit]
Description=Whenever demo: recorded clips played as cameras
After=whenever-demo.service whenever-demo-media.service
Wants=whenever-demo.service whenever-demo-media.service

[Service]
User=whenever
Group=whenever
WorkingDirectory=/srv/whenever/demo/app
Environment=WHENEVER_PORT=8788
Environment=WHENEVER_MEDIA=rtsp://127.0.0.1:8564
Environment=WHENEVER_FULL_WIDTH=1280
Environment=WHENEVER_READ_FPS=4
Environment=WHENEVER_LIVE_WIDTH=1280
ExecStart=/srv/whenever/venv/bin/python camera.py
Restart=always
RestartSec=10
Nice=10
CPUQuota=300%
MemoryMax=4G
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/whenever/demo
# The demo runs as the same Unix user as the real server. So it must not see the real server's keys,
# cameras, rules, data or footage. Only the real server's spend.json stays visible, read-only, for the
# shared budget (WHENEVER_SPEND_ALSO). Install a changed unit with deploy/demo/setup.sh or by hand.
TemporaryFileSystem=/srv/whenever/app/data:ro
BindReadOnlyPaths=-/srv/whenever/app/data/spend.json
InaccessiblePaths=-/srv/whenever/app/.env -/srv/whenever/app/access.env -/srv/whenever/app/actions.env
InaccessiblePaths=-/srv/whenever/app/camera.env -/srv/whenever/app/camera.rtsp.env -/srv/whenever/app/ezviz_open.env
InaccessiblePaths=-/srv/whenever/app/ezviz_token.json -/srv/whenever/app/.ezviz -/srv/whenever/app/rules
InaccessiblePaths=-/srv/whenever/app/logs -/srv/whenever/app/.media -/srv/whenever/settings.env
InaccessiblePaths=-/srv/whenever/media/buffer -/srv/whenever/backup
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
