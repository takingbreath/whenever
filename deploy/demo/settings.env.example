# /srv/whenever/demo/settings.env: the demo server's settings. Copy this file there and fill in the hosts.
WHENEVER_HOST=demo.example.com
WHENEVER_TZ=Asia/Kolkata
WHENEVER_DEMO=1
WHENEVER_SITES=Home: Gate, Gate at night, Driveway, Driveway at night; Cafe: Cafe
# The demo's own daily budget, and the owner's budget for the demo and the real server together.
WHENEVER_SPEND_LIMIT=4
WHENEVER_SPEND_SHARED=10
WHENEVER_SPEND_ALSO=/srv/whenever/app/data/spend.json
# With nobody on the demo for 15 minutes, it stops paying for checks until a visitor comes back.
WHENEVER_IDLE_PAUSE_S=900
# Room for the visitors' own Whenevers beside the starter ones.
WHENEVER_MAX_RULES=9
WHENEVER_HLS=http://127.0.0.1:8898
WHENEVER_PLAYBACK=http://127.0.0.1:9986
WHENEVER_MEDIA_API=http://127.0.0.1:9987
